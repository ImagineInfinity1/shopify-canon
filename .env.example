# Listing Cannon - Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed

# ---------- REQUIRED ----------

# Gemini AI API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Shopify App Credentials (from your Shopify app settings)
# These are used for the OAuth flow — individual store access tokens
# are obtained per-user via OAuth and stored in the database.
SHOPIFY_API_KEY=your_shopify_app_api_key_here
SHOPIFY_API_SECRET=your_shopify_app_api_secret_here

# Flask Session Secret (generate a strong random string)
SESSION_SECRET=your_random_session_secret_here

# Public URL of the app (used for Shopify OAuth callback)
# Local dev: http://localhost:5000
# Production: https://your-app.onrender.com
APP_URL=http://localhost:5000

# ---------- OPTIONAL ----------

# Custom app (single store) — use your store's Custom app token instead of OAuth.
# Set both to connect one store without using the in-app "Connect" flow.
# Get the token from: Shopify Admin → Settings → Apps and sales channels → Develop apps → your app → API credentials → Reveal token.
# SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx

# Database URL (defaults to SQLite for local dev)
# Production (Render): Set via render.yaml / dashboard — auto-provisioned PostgreSQL
# DATABASE_URL=sqlite:///app.db

# Registration toggle (default: false — staff only)
# Set to "true" to allow public signup
REGISTRATION_ENABLED=false
